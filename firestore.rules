rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Core Security Primitives & Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }

    // Secure Admin Identification via Bootstrapped email domain/address in metadata (vasanthankasvk@gmail.com)
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email == 'vasanthankasvk@gmail.com' && 
             request.auth.token.email_verified == true; 
    }

    // 3. Entity-Specific Input & Integrity Checking
    function isValidProfile(data) {
      return data.keys().hasAll(['image', 'updatedAt']) &&
             data.keys().size() == 2 &&
             data.image is string &&
             data.image.size() <= 5000000 && // 5MB Limit to prevent huge payloads
             data.updatedAt is timestamp;
    }

    function isValidWork(data) {
      return data.keys().hasAll([
               'id', 'title', 'category', 'type', 'videoUrl', 
               'thumbnailUrl', 'duration', 'softwareUsed', 'description', 'createdAt'
             ]) &&
             data.keys().size() == 10 &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 200 &&
             data.type is string && (data.type == 'vertical' || data.type == 'landscape' || data.type == 'normal') &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000 &&
             data.duration is string && data.duration.size() <= 20 &&
             data.softwareUsed is list && data.softwareUsed.size() <= 20 &&
             // List boundaries
             (data.softwareUsed.size() == 0 || data.softwareUsed[0] is string) &&
             data.description is string && data.description.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    // 4. Match Rules Execution Path

    // profile collection
    match /profile/{profileId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(profileId) && isValidProfile(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(profileId) && isValidProfile(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(profileId);
    }

    // works collection
    match /works/{workId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(workId) && isValidWork(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(workId) && isValidWork(incoming()) && 
                    incoming().createdAt == existing().createdAt; // Immutable createdAt
      allow delete: if isAdmin() && isValidId(workId);
    }
  }
}
